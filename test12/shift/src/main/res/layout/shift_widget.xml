<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="6dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.18" android:text="오늘" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textColor="#CBD4E9" android:gravity="center" android:maxLines="1"/>
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.30" android:textSize="18sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:maxLines="1"/>
        <ImageView android:id="@+id/widget_badge" android:layout_width="36dp" android:layout_height="0dp" android:layout_weight="0.35" android:scaleType="fitCenter" android:src="@drawable/ic_calendar" android:contentDescription="오늘 근무"/>
        <TextView android:id="@+id/widget_weekday" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.17" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textColor="#CBD4E9" android:gravity="center" android:maxLines="1"/>
        <TextView android:id="@+id/widget_shift" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_divider" android:layout_width="1dp" android:layout_height="match_parent" android:background="#46516B"/>
    <LinearLayout android:id="@+id/widget_note_container" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:orientation="vertical" android:gravity="center_vertical" android:padding="6dp">
        <TextView android:id="@+id/widget_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:includeFontPadding="false" android:textColor="#FFFFFF" android:maxLines="3" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_note_divider" android:layout_width="1dp" android:layout_height="match_parent" android:background="#46516B"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/widget_title_tomorrow" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.18" android:text="내일" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="5sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textColor="#CBD4E9" android:gravity="center" android:maxLines="1"/>
        <TextView android:id="@+id/widget_date_tomorrow" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.30" android:textSize="18sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:maxLines="1"/>
        <ImageView android:id="@+id/widget_badge_tomorrow" android:layout_width="36dp" android:layout_height="0dp" android:layout_weight="0.35" android:scaleType="fitCenter" android:src="@drawable/ic_calendar" android:contentDescription="내일 근무"/>
        <TextView android:id="@+id/widget_weekday_tomorrow" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.17" android:textSize="10sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" android:textColor="#CBD4E9" android:gravity="center" android:maxLines="1"/>
        <TextView android:id="@+id/widget_shift_tomorrow" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
